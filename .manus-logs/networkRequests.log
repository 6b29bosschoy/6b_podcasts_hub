[2026-07-11T11:10:39.147Z] {"timestamp":1783768237468,"type":"fetch","method":"GET","url":"/api/trpc/auth.me,youtube.getVideos,blog.list?batch=1&input=%7B%220%22%3A%7B%22json%22%3Anull%2C%22meta%22%3A%7B%22values%22%3A%5B%22undefined%22%5D%7D%7D%2C%221%22%3A%7B%22json%22%3A%7B%22channel%22%3A%22all%22%2C%22limit%22%3A9%7D%7D%2C%222%22%3A%7B%22json%22%3A%7B%22limit%22%3A3%2C%22offset%22%3A0%7D%7D%7D","request":{"headers":{},"body":null},"response":{"status":200,"statusText":"","headers":{"content-type":"application/json","date":"Sat, 11 Jul 2026 11:10:37 GMT","link":"</.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\"","vary":"trpc-accept","x-powered-by":"Express","x-trace-id":"d5f7b2b1fc427516fc0e865593f1b650"},"body":"[{\"result\":{\"data\":{\"json\":{\"id\":1,\"openId\":\"cbwDgdVKmuYGPKZUfo9xXb\",\"name\":\"Choy Ray\",\"email\":\"choyboss6b29@gmail.com\",\"loginMethod\":\"google\",\"role\":\"admin\",\"createdAt\":\"2026-03-28T03:57:26.000Z\",\"updatedAt\":\"2026-07-11T11:10:13.000Z\",\"lastSignedIn\":\"2026-07-11T11:10:13.000Z\"},\"meta\":{\"values\":{\"createdAt\":[\"Date\"],\"updatedAt\":[\"Date\"],\"lastSignedIn\":[\"Date\"]}}}}},{\"result\":{\"data\":{\"json\":{\"videos\":[{\"id\":\"VVDoud4yUDo\",\"title\":\"塔羅牌占卜準唔準？占卜師親身揭秘背後原理！塔羅師Celia 親解\",\"description\":\"呢句真係中！好多人玩占卜，其實唔係搵答案，而係搵緊心理安慰。\\n但你又有無試過，同一個問題問完又問，結果越問越唔準？\\n\\n本集《路邊 Podcasts》邀請到塔羅牌占卜師 Celia，同主持 Evelyn 一齊傾下塔羅占卜背後嘅大秘密！究竟文字占卜同面對面抽牌有咩分別？點樣先可以搵到一個真正同你「夾」嘅占卜師？\\n\\n如果你最近喺感情或者工作上面都有種迷茫嘅感覺，呢段對話應該會中。\\n\\n#路邊Podcasts #塔羅占卜 #身心靈 #吸引力法則 #香港Podcast #集體潛意識\\n\\n00:00 歡迎來到《路邊 Podcasts》！主持 Evelyn 與占卜師 Celia 介紹\\n00:46 廟街阿婆 vs Cafe占卜：主持親身分享盲目占卜嘅盲點\\n01:25 點解占卜會越問越唔準？反覆發問背後嘅心態秘密\\n02:17 遠距文字占卜準唔準？占卜師揭秘「集體潛意識」連結原理\\n03:02 占卜師自己都要「排毒」？冥想與淨化能量對準確度嘅影響\\n04:12 點解 Celia 會入行做占卜師？原來同「戀愛腦」有關？\\n05:13 面對客嘅挑戰：「你講嘅嘢全部都錯！」最後竟然神反轉？\\n06:12 占卜可以全信嗎？吸引力法則與個人心態嘅真正結合\\n08:38 面對面占卜 vs 文字占卜，究竟有無本質上嘅落差？\\n11:30 Celia 驚爆遇過最瘋狂嘅情緒病個案：占卜變報警？！\\n15:10 下集預告與結尾：點樣搵一個真正啱自己嘅占卜師\\n\\n嘉賓 Celia\\nhttps://www.instagram.com/celia.ymm\\n\\n主持 Evelyn\\nhttps://www.instagram.com/_evelyn____wcy\\n\\n\\n\\n**支持我哋 / Follow Us：**\\n*   👍 鍾意呢條片記得 Like & Share！\\n*   🔔 訂閱「路邊人電台6bpodcasts」YouTube 頻道，緊貼最新影片：[你的頻道訂閱連結，https://www.youtube.com/@6bpodcasts\\n*   💬 留言分享你嘅睇法同經歷！\\n\\n**收聽我哋嘅 Podcast：**\\n*   🍎 Apple Podcast: [點擊收聽](https://apple.co/3nhSxy8)\\n*   🌟 Spotify: [點擊收聽](https://spoti.fi/30EQPOT) \\n*   🎙 KKBOX: [點擊收聽](https://bit.ly/3kLNZ1x) \\n*   💡 其他平台: [點擊收聽](https://bit.ly/30vYTkA) \\n\\n**聯絡我哋 / Contact Us：**\\n*   合作邀約：[ktcreativefirm@gmail.com](mailto:ktcreativefirm@gmail.com) \\n*   WhatsApp: 852 98729990 \\n*   Instagram: @6bpodcast\",\"thumbnail\":\"https://i.ytimg.com/vi/VVDoud4yUDo/maxresdefault.jpg\",\"publishedAt\":\"2026-07-08T13:00:06Z\",\"viewCount\":\"218\",\"likeCount\":\"14\",\"duration\":\"15:29\",\"channelTitle\":\"路邊電台 香港最真實人物訪談\",\"channelId\":\"UCDFLMwJn7YGeJZNj1hhb_fQ\",\"url\":\"https://www.youtube.com/watch?v=VVDoud4yUDo\"},{\"id\":\"AZhXDVpkQrE\",\"title\":\"揭秘香港婚姻介紹所騙局！相親配對中伏實錄公開\",\"description\":\"想搵另一半，分分鐘變咗畀人撳住搶？今日前婚托匿名爆大鑊，揭開尖沙咀某間婚姻介紹所嘅驚人掠水內幕！\\n如果你身邊有單身朋友正打算去參加配對，記得 Send 呢條片畀佢睇\\n\\n想聽更多猛料，歡迎去我嘅 Patreon，有花生想分享都可以 DM 我！  \\n\\n婚姻介紹所, 交友app, 相親配對, 婚托, 香港交友騙案, 尖沙咀黑店, 單身男女, 飯腳Karen, 東張西望, 路邊Podcasts, 6Bpodcasts, 海關投\",\"thumbnail\":\"https://i.ytimg.com/vi/AZhXDVpkQrE/maxresdefault.jpg\",\"publishedAt\":\"2026-07-08T09:11:42Z\",\"viewCount\":\"104\",\"likeCount\":\"10\",\"duration\":\"2:59\",\"channelTitle\":\"路邊電台 香港最真實人物訪談\",\"channelId\":\"UCDFLMwJn7YGeJZNj1hhb_fQ\",\"url\":\"https://www.youtube.com/watch?v=AZhXDVpkQrE\"},{\"id\":\"6zyHu5jivDs\",\"title\":\"全新節目 : 股壇龍虎豹開壇！風水財經兩性世界盃，兩個中年男人乜都敢講｜劉東霖 X 江小魚\",\"description\":\"第一集《股壇龍虎豹》正式開壇🔥\\n\\n右手邊係 行運社長劉東霖，\\n左手邊係 香港股壇極道羅剎江小魚。\\n\\n兩個中年男人坐低，一支咪，乜都吹：\\n風水、財經、兩性、世界盃，全部大踢爆。\\n\\n呢集唔係色情，亦唔係扮高深。\\n而係用最香港、最貼地、最有江湖味嘅方式，\\n同大家講吓男人到咁上下年紀，最關心嘅幾樣嘢：\\n\\n錢點搵？\\n運點行？\\n桃花